      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "{service=\"elearn-api\"} | json",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "title": "eLearn API Logs",
      "type": "logs"
