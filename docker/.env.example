# eLearn Studio — environment variables reference
# Copy this file to docker/.env and fill in the values.

# ─── API ─────────────────────────────────────────────────────────────────────
PORT=3001
CORS_ORIGIN=http://localhost:3000

# ─── JWT (T171) ───────────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production

# ─── MongoDB ─────────────────────────────────────────────────────────────────
MONGO_URI=mongodb://mongodb:27017/elearn

# ─── Garage S3 ───────────────────────────────────────────────────────────────
GARAGE_ENDPOINT=garage
GARAGE_PORT=3900
GARAGE_USE_SSL=false
GARAGE_REGION=garage
GARAGE_BUCKET=elearn-assets
GARAGE_ACCESS_KEY=
GARAGE_SECRET_KEY=

# Public-facing URL for Garage used in pre-signed asset URLs sent to browsers.
# In development this is typically http://localhost:3900 (same as GARAGE_ENDPOINT
# if Garage is port-forwarded). In production set this to the public hostname.
S3_PUBLIC_ENDPOINT=http://localhost:3900

# ─── Asset upload limits (T166) ──────────────────────────────────────────────
# Maximum upload size in MB (default: 50).
MAX_ASSET_SIZE_MB=50

# Comma-separated allowlist of MIME types (default: images, video, audio, PDF).
# Uncomment and edit to restrict further.
# ALLOWED_MIME_TYPES=image/jpeg,image/png,image/gif,image/webp,image/svg+xml,video/mp4,video/webm,audio/mpeg,audio/ogg,audio/wav,application/pdf

# ─── Logging (T162) ──────────────────────────────────────────────────────────
# Pino log level: trace | debug | info | warn | error | fatal  (default: info)
LOG_LEVEL=info

# ─── OpenTelemetry (T162 / T170) ─────────────────────────────────────────────
# OTLP endpoint — must point to the OTel Collector, NOT directly to Tempo.
# The Collector fans out traces → Tempo and metrics → Prometheus.
# Leave unset to disable trace export (SDK runs silently, no data is sent).
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_SERVICE_NAME=elearn-api

# ─── Observability (T170) ─────────────────────────────────────────────────────
# Grafana admin password — change this for any non-local deployment.
GRAFANA_ADMIN_PASSWORD=changeme
