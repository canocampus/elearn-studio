# Test environment — used by Vitest (mode=test)
# Sets API_BASE to absolute URL so MSW handlers (registered at http://localhost:3001/...)
# intercept fetch calls made by apiClient.ts during unit tests.
# In browser/E2E, VITE_API_URL is unset so API_BASE='' routes through Vite proxy.
VITE_API_URL=http://localhost:3001
