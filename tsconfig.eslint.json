{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "allowJs": false,
    "skipLibCheck": true
  },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/src/**/*.tsx",
    "backend/*/src/**/*.ts",
    "e2e/**/*.ts",
    "e2e/**/*.tsx"
  ],
  "exclude": [
    "**/node_modules",
    "**/dist",
    "**/build",
    "**/coverage"
  ]
}
